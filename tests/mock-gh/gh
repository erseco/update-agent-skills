#!/usr/bin/env bash
# Offline stand-in for the GitHub CLI, emulating the `gh skill update` behaviour this action relies on
# (observed with gh 2.103): output on stderr, `--dir X` scans X/*/SKILL.md only, an update replaces
# the whole skill directory, and unreachable upstreams are reported as `! Skipping` with exit 0.
#
#   MOCK_GH_VERSION        version printed by `gh --version` (default 2.95.0)
#   MOCK_GH_NO_SKILL=1     `gh skill` is unknown
#   MOCK_UPSTREAM          directory holding the upstream copy of each skill, by skill name;
#                          a skill without one is up to date
#   MOCK_GH_LOG            every `gh skill update` call is appended here
#   MOCK_GH_FAIL=N         the first N update calls fail (counted in $MOCK_GH_LOG)
#   MOCK_GH_FAIL_MODE      `exit` (non-zero status, default), `skip` (`! Skipping`, exit 0) or
#                          `layout` (upstream publishes no skill where gh looks, exit 0)
#   MOCK_GH_ECHO           extra text printed by every update call
#   MOCK_GH_FORK           `gh api repos/<repo> --jq .fork` prints `true` or `false` (default);
#                          any other value makes the call fail
set -euo pipefail

if [[ "${1:-}" == --version ]]; then
  echo "gh version ${MOCK_GH_VERSION:-2.95.0} (2026-01-01)"
  echo "https://github.com/cli/cli/releases/tag/v${MOCK_GH_VERSION:-2.95.0}"
  exit 0
fi
if [[ "${1:-}" == api ]]; then
  echo "$*" >>"${MOCK_GH_LOG:-/dev/null}"
  case "${MOCK_GH_FORK:-false}" in
    true | false) echo "${MOCK_GH_FORK:-false}" ;;
    *) echo "HTTP 404: Not Found (https://api.github.com/${2:-})" >&2; exit 1 ;;
  esac
  exit 0
fi
if [[ "${1:-}" != skill || -n "${MOCK_GH_NO_SKILL:-}" ]]; then
  echo "unknown command \"${1:-}\" for \"gh\"" >&2
  exit 1
fi
if [[ "${2:-}" == --help ]]; then exit 0; fi
[[ "${2:-}" == update ]] || { echo "mock gh: unsupported: $*" >&2; exit 1; }
shift 2

all=false dir="" dry=false unpin=false
while (($#)); do
  case "$1" in
    --all) all=true ;;
    --dir) dir=$2; shift ;;
    --dry-run) dry=true ;;
    --unpin) unpin=true ;;
    *) echo "unknown flag: $1" >&2; exit 1 ;;
  esac
  shift
done
[[ "$all" == true ]] || { echo "mock gh: expected --all" >&2; exit 1; }

log=${MOCK_GH_LOG:-/dev/null}
echo "update dir=$dir dry-run=$dry unpin=$unpin" >>"$log"
if [[ -n "${MOCK_GH_ECHO:-}" ]]; then echo "$MOCK_GH_ECHO" >&2; fi

calls=$(grep -c '^update ' "$log" 2>/dev/null || true)
if ((${calls:-0} <= ${MOCK_GH_FAIL:-0})); then
  if [[ "${MOCK_GH_FAIL_MODE:-}" == layout ]]; then
    echo "! Skipping demo: no skills found in owner/repo" >&2
    echo "  Expected skills in skills/*/SKILL.md, skills/{scope}/*/SKILL.md," >&2
    echo "All skills are up to date." >&2
    exit 0
  fi
  if [[ "${MOCK_GH_FAIL_MODE:-exit}" == skip ]]; then
    echo "! Skipping demo: could not resolve owner/repo: HTTP 401: Bad credentials" >&2
    echo "All skills are up to date." >&2
    exit 0
  fi
  echo "HTTP 502: Bad Gateway" >&2
  exit 1
fi

available=()
for md in "$dir"/*/SKILL.md; do
  [[ -f "$md" ]] || continue
  skill_dir=$(dirname "$md") name=$(basename "$(dirname "$md")")
  if grep -q 'github-pinned:' "$md" && [[ "$unpin" == false ]]; then
    echo "⊘ $name is pinned (skipped)" >&2
  elif ! grep -q 'github-repo:' "$md"; then
    echo "! $name has no GitHub metadata. Run \`gh skill update $name\` interactively to add metadata, or reinstall to enable updates" >&2
  elif [[ -d "${MOCK_UPSTREAM:-/nonexistent}/$name" ]]; then
    available+=("$skill_dir")
  fi
done

if ((${#available[@]} == 0)); then
  echo "All skills are up to date." >&2
  exit 0
fi
printf '\n%s update(s) available:\n' "${#available[@]}" >&2
for skill_dir in "${available[@]}"; do
  echo "  • $(basename "$skill_dir") (owner/repo)  > 1234abcd [main]" >&2
done
[[ "$dry" == true ]] && exit 0
for skill_dir in "${available[@]}"; do
  rm -rf "$skill_dir"
  cp -RPp "$MOCK_UPSTREAM/$(basename "$skill_dir")" "$skill_dir"
  echo "Updated $(basename "$skill_dir")" >&2
done
